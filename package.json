{
  "name": "otya-system-web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "sync:brand": "node scripts/sync-brand-assets.mjs",
    "predev": "npm run sync:brand",
    "dev": "next dev",
    "prebuild": "npm run sync:brand",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "validate:config": "node validate-config.mjs",
    "verify:migrations": "node scripts/verify-migration-layout.mjs",
    "check": "npm run validate:config && npm run verify:migrations && npm test && npm run typecheck && npm run lint",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high",
    "prepreview": "npm run sync:brand",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "predeploy": "npm run sync:brand && npm run verify:migrations",
    "deploy": "node scripts/ensure-admin-session-secret.mjs && opennextjs-cloudflare build && node scripts/deploy-core-version.mjs && node scripts/verify-admin-mfa.mjs",
    "maintenance:edge-csp": "bash scripts/remove-legacy-edge-csp.sh",
    "cf-typegen": "wrangler types",
    "migrate:remote:apply": "node scripts/require-remote-d1-migration-approval.mjs && npx wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.16",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "postcss": "8.5.25",
    "prettier": "3.8.3",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.4",
    "typescript": "5.9.3",
    "wrangler": "4.159.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  }
}